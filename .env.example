# Telegram
BOT_TOKEN=your_telegram_bot_token_here
# Telegram user id allowed to run /stats
ADMIN_USER_ID=123456789

# https://api.apilayer.com/currency_data
API_KEY=your_apilayer_key_here

# One of CRITICAL / ERROR / WARNING / INFO / DEBUG (case-insensitive). DEBUG turns on
# the bot's own verbose logging only: the HTTP client loggers are deliberately clamped to
# max(INFO, LOG_LEVEL), so DEBUG does not enable request logging and the bot token (part
# of every Telegram API URL) does not reach the log through the loggers. An uncaught
# exception can still print a traceback with the full request URL to stderr.
LOG_LEVEL=INFO

# State files, relative to the working directory (/app in the container, the repo
# root under `make run`). The defaults are fine — override only if you must.
# The two *_DB_PATH files are sqlite databases (sqlite also creates a -wal and a
# -shm file next to each). On first start each one imports the same-named .json
# from the old pickleDB storage and renames it to *.json.migrated — so do NOT
# point these at the old .json files, a .json path is rejected at startup.
# EXCHANGE_RATES_CACHE_PATH=data/exchange_rates_cache.json
# STATISTICS_DB_PATH=data/statistics.db
# USER_SETTINGS_DB_PATH=data/user_settings.db

# Optional InfluxDB metrics. Leave INFLUX_VERSION unset to disable reporting.
# INFLUX_VERSION=2
# INFLUX_URL=http://influxdb:8086
# INFLUX_TOPIC=bots/currva_converter_bot
# INFLUX_REPORTING_PERIOD=300
# InfluxDB 2.x
# INFLUX_TOKEN=your_token_here
# INFLUX_ORG=your_org
# INFLUX_BUCKET=your_bucket
# InfluxDB 1.8
# INFLUX_DB=your_db
# INFLUX_USER=your_user
# INFLUX_PASSWORD=your_password
